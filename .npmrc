# Flat (hoisted) node_modules layout instead of pnpm's default isolated/symlinked
# one. Fixes "Cannot find native binding" for @tailwindcss/oxide's per-platform
# packages in Docker/CI builds (Railway/Nixpacks) — those packages do a plain
# require() that doesn't reliably resolve pnpm's symlinked layout in that
# environment. Native packages like better-sqlite3/esbuild also benefit from
# being trivially resolvable from anywhere in the tree.
node-linker=hoisted
